#!/usr/bin/env python3
"""
Build the ResearchOS home dashboard from QMD/YAML metadata.

Output:
    _generated/dashboard.md

The generated dashboard is static HTML/Markdown and therefore works on
GitHub Pages without a database or application server.
"""

from __future__ import annotations

import html
import os
import re
from collections import Counter, defaultdict
from dataclasses import dataclass
from datetime import date, datetime, timedelta
from pathlib import Path
from typing import Any
from urllib.parse import quote
from zoneinfo import ZoneInfo

import yaml


ROOT = Path(__file__).resolve().parents[1]
CONFIG_PATH = ROOT / "config" / "researchos.yml"
OUTPUT = ROOT / "_generated" / "dashboard.md"

COLLECTIONS = {
    "project": "projects",
    "paper": "papers",
    "idea": "ideas",
    "experiment": "experiments",
    "dataset": "datasets",
    "literature": "literature",
    "method": "methods",
}

PAPER_ORDER = [
    "idea",
    "analysis",
    "drafting",
    "internal-review",
    "submitted",
    "revision",
    "accepted",
    "published",
    "archived",
]

EXPERIMENT_ORDER = [
    "planned",
    "ready",
    "running",
    "blocked",
    "completed",
    "failed",
    "archived",
]

LITERATURE_ORDER = [
    "inbox",
    "reading",
    "read",
    "synthesized",
    "cited",
    "archived",
]

SUCCESS_STATUSES = {
    "completed",
    "published",
    "accepted",
    "stable",
    "read",
    "synthesized",
    "cited",
    "frozen",
}

WARNING_STATUSES = {
    "planning",
    "planned",
    "evaluating",
    "revision",
    "ready",
    "acquiring",
    "validating",
}

DANGER_STATUSES = {"blocked", "failed"}

INFO_STATUSES = {
    "active",
    "analysis",
    "drafting",
    "internal-review",
    "submitted",
    "reading",
    "running",
    "processing",
}


@dataclass
class Record:
    path: Path
    data: dict[str, Any]
    text: str


def load_config() -> dict[str, Any]:
    defaults = {
        "site": {
            "github_owner": "mengyuchi",
            "github_repo": "researchos",
            "github_branch": "main",
        },
        "timezone": "Asia/Shanghai",
        "dashboard": {
            "activity_days": 365,
            "recent_items": 8,
            "today_task_limit": 8,
        },
    }
    if not CONFIG_PATH.exists():
        return defaults

    user = yaml.safe_load(CONFIG_PATH.read_text(encoding="utf-8")) or {}
    for key, value in user.items():
        if isinstance(value, dict) and isinstance(defaults.get(key), dict):
            defaults[key].update(value)
        else:
            defaults[key] = value
    return defaults


CONFIG = load_config()
TZ_NAME = os.getenv("RESEARCHOS_TZ", CONFIG["timezone"])
try:
    TZ = ZoneInfo(TZ_NAME)
except Exception as exc:
    raise SystemExit(f"Invalid ResearchOS timezone {TZ_NAME!r}: {exc}")

NOW = datetime.now(TZ)
TODAY = NOW.date()


def esc(value: Any) -> str:
    return html.escape(str(value), quote=True)


def split_front_matter(text: str) -> tuple[dict[str, Any], str]:
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        raise ValueError("missing YAML front matter")

    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            end = i
            break
    if end is None:
        raise ValueError("unclosed YAML front matter")

    data = yaml.safe_load("\n".join(lines[1:end])) or {}
    if not isinstance(data, dict):
        raise ValueError("front matter is not a YAML mapping")

    body = "\n".join(lines[end + 1 :])
    return data, body


def read_record(path: Path) -> Record:
    text = path.read_text(encoding="utf-8")
    data, _ = split_front_matter(text)
    return Record(path=path, data=data, text=text)


def discover_records() -> list[Record]:
    records: list[Record] = []

    for object_type, folder in COLLECTIONS.items():
        base = ROOT / folder
        if not base.exists():
            continue
        for child in sorted(base.iterdir()):
            qmd = child / "index.qmd"
            if child.is_dir() and qmd.exists():
                records.append(read_record(qmd))

    logs = ROOT / "logs"
    if logs.exists():
        for qmd in sorted(logs.glob("[0-9][0-9][0-9][0-9]/*.qmd")):
            records.append(read_record(qmd))

    return records


def record_date(value: Any) -> date | None:
    if isinstance(value, datetime):
        return value.date()
    if isinstance(value, date):
        return value
    if isinstance(value, str) and value.strip():
        try:
            return date.fromisoformat(value.strip())
        except ValueError:
            return None
    return None


def record_datetime(value: Any) -> datetime | None:
    if isinstance(value, datetime):
        return value
    if isinstance(value, str) and value.strip():
        try:
            return datetime.fromisoformat(value.strip())
        except ValueError:
            return None
    return None


def object_href(record: Record) -> str:
    rel = record.path.relative_to(ROOT)
    if rel.name == "index.qmd":
        return esc(str(rel.parent).replace(os.sep, "/") + "/")
    return esc(str(rel).replace(os.sep, "/"))


def github_edit_url(path: Path) -> str:
    owner = CONFIG["site"]["github_owner"]
    repo = CONFIG["site"]["github_repo"]
    branch = CONFIG["site"]["github_branch"]
    rel = path.relative_to(ROOT).as_posix()
    return (
        f"https://github.com/{quote(str(owner))}/{quote(str(repo))}"
        f"/edit/{quote(str(branch))}/{quote(rel)}"
    )


def github_new_log_url(year: int) -> str:
    owner = CONFIG["site"]["github_owner"]
    repo = CONFIG["site"]["github_repo"]
    branch = CONFIG["site"]["github_branch"]
    return (
        f"https://github.com/{quote(str(owner))}/{quote(str(repo))}"
        f"/new/{quote(str(branch))}/logs/{year}"
    )


def status_badge(status: Any) -> str:
    status = str(status or "unknown")
    css = ""
    if status in SUCCESS_STATUSES:
        css = " ros-badge-success"
    elif status in WARNING_STATUSES:
        css = " ros-badge-warning"
    elif status in DANGER_STATUSES:
        css = " ros-badge-danger"
    elif status in INFO_STATUSES:
        css = " ros-badge-info"
    return f'<span class="ros-badge{css}">{esc(status)}</span>'


def parse_section(body: str, heading: str) -> str:
    pattern = re.compile(
        rf"(?ms)^#\s+{re.escape(heading)}\s*$\n(.*?)(?=^#\s+|\Z)"
    )
    match = pattern.search(body)
    return match.group(1).strip() if match else ""


def parse_tasks(section: str, checked: bool | None = None) -> list[str]:
    tasks: list[str] = []
    for line in section.splitlines():
        match = re.match(r"^\s*[-*]\s+\[([ xX])\]\s*(.+?)\s*$", line)
        if not match:
            continue
        is_checked = match.group(1).lower() == "x"
        text = match.group(2).strip()
        if not text:
            continue
        if checked is None or checked == is_checked:
            tasks.append(text)
    return tasks


def meaningful_bullets(section: str) -> int:
    count = 0
    for line in section.splitlines():
        line = line.strip()
        if re.match(r"^[-*]\s+\S+", line) and line not in {"-", "*"}:
            count += 1
    return count


def progress_value(record: Record) -> float | None:
    value = record.data.get("research_progress")
    if value is None or value == "":
        return None
    if isinstance(value, bool):
        return None
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    if not 0 <= number <= 100:
        return None
    return number


def due_date(record: Record) -> date | None:
    for key in ("due", "submission_target"):
        d = record_date(record.data.get(key))
        if d:
            return d
    return None


def render_stat_card(label: str, value: int, note: str, href: str) -> str:
    return f"""
<a class="ros-stat-card" href="{esc(href)}">
  <span class="ros-stat-label">{esc(label)}</span>
  <span class="ros-stat-value">{value}</span>
  <span class="ros-stat-note">{esc(note)}</span>
</a>""".strip()


def render_today_focus(logs: list[Record]) -> str:
    today_log = next(
        (
            r
            for r in logs
            if record_date(r.data.get("date")) == TODAY
        ),
        None,
    )

    source = today_log
    fallback_note = ""

    if source is None and logs:
        dated_logs = [
            (record_date(r.data.get("date")), r)
            for r in logs
            if record_date(r.data.get("date"))
        ]
        if dated_logs:
            _, source = max(dated_logs, key=lambda item: item[0])
            fallback_date = record_date(source.data.get("date"))
            fallback_note = (
                f'<div class="ros-card-meta">No log for today; showing '
                f'latest plan from {esc(fallback_date)}.</div>'
            )

    if source is None:
        return f"""
<div class="ros-card">
  <div class="ros-card-header">
    <h2 class="ros-card-title">Today's Focus</h2>
    <a class="ros-button ros-button-primary" href="{github_new_log_url(TODAY.year)}" target="_blank">Create Today's Log ↗</a>
  </div>
  <div class="ros-empty">No research log exists yet.</div>
</div>
""".strip()

    _, body = split_front_matter(source.text)
    next_actions = parse_tasks(parse_section(body, "Next Actions"), checked=False)
    in_progress = parse_tasks(parse_section(body, "In Progress"), checked=False)

    tasks: list[str] = []
    for item in in_progress + next_actions:
        if item not in tasks:
            tasks.append(item)

    limit = int(CONFIG["dashboard"]["today_task_limit"])
    tasks = tasks[:limit]

    if tasks:
        task_html = "\n".join(
            f"""<li class="ros-task-item">
  <span class="ros-checkbox" aria-hidden="true"></span>
  <div class="ros-item-main">{esc(task)}</div>
</li>"""
            for task in tasks
        )
    else:
        task_html = '<li class="ros-empty">No open checkbox tasks in the current log.</li>'

    edit_label = "Edit Today's Plan ↗" if today_log else "Edit Latest Plan ↗"

    return f"""
<div class="ros-card">
  <div class="ros-card-header">
    <div>
      <h2 class="ros-card-title">Today's Focus</h2>
      {fallback_note}
    </div>
    <a class="ros-button ros-button-primary" href="{github_edit_url(source.path)}" target="_blank">{edit_label}</a>
  </div>
  <ul class="ros-task-list">
    {task_html}
  </ul>
</div>
""".strip()


def render_attention(records: list[Record]) -> str:
    candidates: list[tuple[int, date | None, Record, str]] = []

    for record in records:
        if record.data.get("object_type") == "research-log":
            continue
        status = str(record.data.get("status") or "")
        due = due_date(record)

        if status in DANGER_STATUSES:
            candidates.append((0, due, record, status))
        elif due and due <= TODAY + timedelta(days=30):
            candidates.append((1, due, record, status))

    candidates.sort(
        key=lambda x: (
            x[0],
            x[1] or date.max,
            str(x[2].data.get("title", "")),
        )
    )

    if not candidates:
        content = '<div class="ros-empty">No blocked items or deadlines within 30 days.</div>'
    else:
        rows = []
        for _, due, record, status in candidates[:8]:
            due_text = f" · due {due.isoformat()}" if due else ""
            rows.append(
                f"""<li class="ros-object-item">
  <div class="ros-item-main">
    <a class="ros-item-title" href="{object_href(record)}">{esc(record.data.get("title", record.data.get("id", "Untitled")))}</a>
    <div class="ros-item-subtitle">{esc(record.data.get("id", ""))}{esc(due_text)}</div>
  </div>
  {status_badge(status)}
</li>"""
            )
        content = '<ul class="ros-object-list">' + "\n".join(rows) + "</ul>"

    return f"""
<div class="ros-card">
  <div class="ros-card-header">
    <h2 class="ros-card-title">Upcoming / Blocked</h2>
    <span class="ros-card-meta">Next 30 days</span>
  </div>
  {content}
</div>
""".strip()


def activity_score(log: Record) -> int:
    _, body = split_front_matter(log.text)
    checked = len(parse_tasks(body, checked=True))
    completed = meaningful_bullets(parse_section(body, "Completed"))
    results = meaningful_bullets(parse_section(body, "Results"))
    literature = meaningful_bullets(parse_section(body, "Literature Read"))
    return 1 + (2 * checked) + completed + results + literature


def render_heatmap(records: list[Record], logs: list[Record]) -> str:
    days = max(30, int(CONFIG["dashboard"]["activity_days"]))
    start = TODAY - timedelta(days=days - 1)

    scores: defaultdict[date, int] = defaultdict(int)

    for log in logs:
        d = record_date(log.data.get("date"))
        if d:
            scores[d] += activity_score(log)

    for record in records:
        if record.data.get("object_type") == "research-log":
            continue
        d = record_date(record.data.get("updated"))
        if d:
            scores[d] += 1

    def level(score: int) -> int:
        if score <= 0:
            return 0
        if score == 1:
            return 1
        if score <= 3:
            return 2
        if score <= 6:
            return 3
        return 4

    # Calendar grid runs Sunday -> Saturday by columns.
    start_sunday = start - timedelta(days=(start.weekday() + 1) % 7)
    today_sunday_index = (TODAY.weekday() + 1) % 7
    end_saturday = TODAY + timedelta(days=6 - today_sunday_index)

    cells = []
    current = start_sunday
    while current <= end_saturday:
        if current < start or current > TODAY:
            cells.append('<span class="ros-heat-cell outside-range"></span>')
        else:
            score = scores[current]
            cells.append(
                f'<span class="ros-heat-cell level-{level(score)}" '
                f'title="{current.isoformat()}: activity score {score}"></span>'
            )
        current += timedelta(days=1)

    total_active_days = sum(1 for d, score in scores.items() if start <= d <= TODAY and score > 0)

    legend = """
<div class="ros-heat-legend">
  <span>Less</span>
  <span class="ros-heat-cell level-0"></span>
  <span class="ros-heat-cell level-1"></span>
  <span class="ros-heat-cell level-2"></span>
  <span class="ros-heat-cell level-3"></span>
  <span class="ros-heat-cell level-4"></span>
  <span>More</span>
</div>
""".strip()

    return f"""
<div class="ros-card">
  <div class="ros-card-header">
    <h2 class="ros-card-title">Research Activity</h2>
    <span class="ros-card-meta">{total_active_days} active days · last {days} days</span>
  </div>
  <div class="ros-heatmap-wrap">
    <div class="ros-heatmap-grid">
      {''.join(cells)}
    </div>
  </div>
  {legend}
</div>
""".strip()


def render_distribution(title: str, records: list[Record], order: list[str]) -> str:
    counts = Counter(str(r.data.get("status") or "unknown") for r in records)
    total = sum(counts.values())
    max_count = max(counts.values(), default=1)

    rows = []
    for status in order:
        count = counts.get(status, 0)
        width = (count / max_count * 100) if max_count else 0
        rows.append(
            f"""<div class="ros-status-row">
  <div class="ros-status-name">{esc(status)}</div>
  <div class="ros-status-count">{count}</div>
  <div class="ros-status-track"><div class="ros-status-fill" style="width:{width:.1f}%"></div></div>
</div>"""
        )

    return f"""
<div class="ros-card">
  <div class="ros-card-header">
    <h2 class="ros-card-title">{esc(title)}</h2>
    <span class="ros-card-meta">{total} total</span>
  </div>
  {''.join(rows)}
</div>
""".strip()


def render_progress_card(
    title: str,
    records: list[Record],
    href: str,
    *,
    excluded_statuses: set[str] | None = None,
    limit: int = 6,
) -> str:
    excluded_statuses = excluded_statuses or set()

    visible = [
        r for r in records
        if str(r.data.get("status") or "") not in excluded_statuses
    ]

    visible.sort(
        key=lambda r: (
            progress_value(r) is None,
            -(progress_value(r) or 0),
            str(r.data.get("title", "")),
        )
    )
    visible = visible[:limit]

    if not visible:
        content = '<div class="ros-empty">No active records found.</div>'
    else:
        rows = []
        for record in visible:
            progress = progress_value(record)
            ptext = "Not set" if progress is None else f"{progress:g}%"
            width = 0 if progress is None else progress
            next_action = str(record.data.get("next_action") or "").strip()
            next_html = (
                f'<div class="ros-item-subtitle">Next: {esc(next_action)}</div>'
                if next_action
                else ""
            )
            rows.append(
                f"""<div class="ros-progress-row">
  <div class="ros-progress-head">
    <div class="ros-progress-label">
      <a href="{object_href(record)}">{esc(record.data.get("title", record.data.get("id", "Untitled")))}</a>
      {next_html}
    </div>
    <div>{status_badge(record.data.get("status"))} <span class="ros-progress-value">{esc(ptext)}</span></div>
  </div>
  <div class="ros-progress-track"><div class="ros-progress-fill" style="width:{width:.1f}%"></div></div>
</div>"""
            )
        content = "".join(rows)

    return f"""
<div class="ros-card">
  <div class="ros-card-header">
    <h2 class="ros-card-title">{esc(title)}</h2>
    <a class="ros-button" href="{esc(href)}">Open →</a>
  </div>
  {content}
</div>
""".strip()


def render_recent(records: list[Record]) -> str:
    non_logs = [
        r for r in records
        if r.data.get("object_type") != "research-log"
    ]

    def key(record: Record) -> tuple[datetime, str]:
        dt = record_datetime(record.data.get("updated_at"))
        if dt is None:
            d = record_date(record.data.get("updated"))
            dt = datetime.combine(d or date.min, datetime.min.time(), tzinfo=TZ)
        elif dt.tzinfo is None:
            dt = dt.replace(tzinfo=TZ)
        return (dt.astimezone(TZ), str(record.data.get("title", "")))

    recent = sorted(non_logs, key=key, reverse=True)[
        : int(CONFIG["dashboard"]["recent_items"])
    ]

    if not recent:
        content = '<div class="ros-empty">No ResearchOS objects found.</div>'
    else:
        rows = []
        for record in recent:
            d = record_date(record.data.get("updated"))
            object_type = record.data.get("object_type", "")
            rows.append(
                f"""<li class="ros-activity-item">
  <div class="ros-item-main">
    <a class="ros-item-title" href="{object_href(record)}">{esc(record.data.get("title", record.data.get("id", "Untitled")))}</a>
    <div class="ros-item-subtitle">{esc(record.data.get("id", ""))} · {esc(object_type)} · updated {esc(d or "unknown")}</div>
  </div>
  {status_badge(record.data.get("status"))}
</li>"""
            )
        content = '<ul class="ros-activity-list">' + "\n".join(rows) + "</ul>"

    return f"""
<div class="ros-card">
  <div class="ros-card-header">
    <h2 class="ros-card-title">Recently Updated</h2>
    <span class="ros-card-meta">ResearchOS objects</span>
  </div>
  {content}
</div>
""".strip()


def build() -> str:
    records = discover_records()
    by_type: defaultdict[str, list[Record]] = defaultdict(list)
    for record in records:
        by_type[str(record.data.get("object_type", "unknown"))].append(record)

    projects = by_type["project"]
    papers = by_type["paper"]
    experiments = by_type["experiment"]
    literature = by_type["literature"]
    logs = by_type["research-log"]

    active_projects = sum(
        1 for r in projects
        if r.data.get("status") not in {"completed", "archived"}
    )
    active_papers = sum(
        1 for r in papers
        if r.data.get("status") not in {"accepted", "published", "archived"}
    )
    running_experiments = sum(
        1 for r in experiments
        if r.data.get("status") in {"ready", "running", "blocked"}
    )
    read_literature = sum(
        1 for r in literature
        if r.data.get("status") in {"read", "synthesized", "cited"}
    )

    stat_cards = "\n".join(
        [
            render_stat_card(
                "Projects",
                len(projects),
                f"{active_projects} active / planning",
                "projects/",
            ),
            render_stat_card(
                "Papers",
                len(papers),
                f"{active_papers} in active pipeline",
                "papers/",
            ),
            render_stat_card(
                "Experiments",
                len(experiments),
                f"{running_experiments} ready / running / blocked",
                "experiments/",
            ),
            render_stat_card(
                "Literature",
                len(literature),
                f"{read_literature} read / synthesized / cited",
                "literature/",
            ),
        ]
    )

    generated_at = NOW.isoformat(timespec="minutes")

    return f"""
<div class="ros-dashboard">

<section class="ros-hero">
  <div>
    <p class="ros-eyebrow">Academic Research Operating System</p>
    <h1>ResearchOS</h1>
    <p class="ros-hero-subtitle">
      A metadata-driven cockpit for research projects, manuscripts, experiments,
      literature, datasets, methods, ideas, and daily research activity.
    </p>
  </div>
  <div class="ros-hero-date">
    <strong>{esc(TODAY.strftime("%A"))}</strong><br>
    {esc(TODAY.isoformat())}
  </div>
</section>

<section class="ros-stat-grid">
{stat_cards}
</section>

<section class="ros-two-column">
{render_today_focus(logs)}
{render_attention(records)}
</section>

<section>
{render_heatmap(records, logs)}
</section>

<section class="ros-three-column">
{render_distribution("Paper Pipeline", papers, PAPER_ORDER)}
{render_distribution("Experiment Status", experiments, EXPERIMENT_ORDER)}
{render_distribution("Literature Reading", literature, LITERATURE_ORDER)}
</section>

<section class="ros-three-column">
{render_progress_card("Project Progress", projects, "projects/", excluded_statuses={"completed", "archived"})}
{render_progress_card("Paper Progress", papers, "papers/", excluded_statuses={"accepted", "published", "archived"})}
{render_progress_card("Experiment Progress", experiments, "experiments/", excluded_statuses={"completed", "failed", "archived"})}
</section>

<section>
{render_recent(records)}
</section>

<div class="ros-footer-note">
  Dashboard generated {esc(generated_at)} · timezone {esc(TZ_NAME)}
</div>

</div>
""".strip() + "\n"


def main() -> None:
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    raw_html = build().rstrip()
    rendered = "```{=html}
" + raw_html + "
```
"
    OUTPUT.write_text(rendered, encoding="utf-8")
    print(f"ResearchOS dashboard generated: {OUTPUT.relative_to(ROOT)}")


if __name__ == "__main__":
    main()
